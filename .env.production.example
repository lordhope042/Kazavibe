# Copy to .env.production on the SERVER. Never commit it or share it.
DOMAIN="kazavibe.example.com"      # your domain (or 1-2-3-4.sslip.io for a free test address)
APP_URL="https://kazavibe.example.com"
DB_PASSWORD=""                     # letters and numbers only. Make one with:  openssl rand -hex 16
SESSION_SECRET=""                  # openssl rand -base64 32
OTP_SECRET=""                      # openssl rand -base64 32

MAIL_MODE="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""                       # a NEW Gmail App Password
MAIL_FROM_NAME="KazaVibe"

PAYSTACK_SECRET_KEY=""             # sk_test_... until your business is verified
PLUS_PRICE_NGN="1000"

VAPID_PUBLIC_KEY=""                # npm run vapid
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

SMS_PROVIDER="console"             # "termii" for real SMS
TERMII_API_KEY=""
TERMII_SENDER_ID=""

TURN_URLS=""                       # e.g. turn:kazavibe.example.com:3478?transport=udp,turn:kazavibe.example.com:3478?transport=tcp
TURN_SECRET=""                     # openssl rand -hex 32 (same value coturn uses)

NEXT_PUBLIC_SUPPORT_EMAIL=""
