DATABASE_URL="postgresql://kazavibe:kazavibe@localhost:5432/kazavibe"
# Generate with: openssl rand -base64 32
SESSION_SECRET=""
STORAGE_DIR="./storage"

# Payments (Paystack). Use your TEST secret key (sk_test_...) while developing. Keep it only in this file.
PAYSTACK_SECRET_KEY=""
APP_URL="http://localhost:3000"   # public address of the site, used for the payment return page
PLUS_PRICE_NGN="1000"             # price of 1 month of Plus in naira (3 and 12 month prices are derived)

# Push notifications. Generate keys with:  npm run vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# SMS (phone-code sign-in). "console" prints codes in the terminal. "termii" sends real SMS.
SMS_PROVIDER="console"
TERMII_API_KEY=""
TERMII_SENDER_ID=""

# Calls: a TURN relay makes calls work on mobile data. Without it only some networks connect.
TURN_URLS=""              # e.g. turn:your-turn-host:3478,turns:your-turn-host:5349
TURN_USERNAME=""
TURN_CREDENTIAL=""
TURN_SECRET=""            # alternative to username/credential: coturn "static-auth-secret"

# Email (verification codes + password reset)
MAIL_MODE="smtp"          # "smtp" sends real email. "console" prints the code in the terminal (handy for testing).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""              # your Gmail address
SMTP_PASS=""              # a Gmail App Password (16 letters). NEVER your normal password.
MAIL_FROM_NAME="KazaVibe"
OTP_SECRET=""             # long random text, 32+ characters
NEXT_PUBLIC_SUPPORT_EMAIL=""
